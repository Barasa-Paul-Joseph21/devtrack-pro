modules = ["nodejs-20", "dotnet-7.0", "web"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c 'cd TaskManagerAPI && dotnet bin/publish/TaskManagerAPI.dll & cd frontend && npm run dev'"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "vm"
run = ["bash", "-c", "cd TaskManagerAPI && dotnet bin/publish/TaskManagerAPI.dll & cd frontend && npm run dev -- --port 5000 --host 0.0.0.0"]
build = ["bash", "-c", "cd TaskManagerAPI && dotnet publish -c Release -o bin/publish && cd ../frontend && npm install && npm run build"]
